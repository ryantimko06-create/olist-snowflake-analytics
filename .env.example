# copy to .env and fill in. .env is gitignored

# account identifier, from snowsight > account details. looks like ABCDEFG-XY12345
SNOWFLAKE_ACCOUNT=

# NOT the username - the LOGIN_NAME which is most likely your email.
#don't make the same mistake I made!!
# check with: show users;  and look at the login_name column
SNOWFLAKE_USER=

# plain password login is blocked by MFA from scripts, so this is a
# programmatic access token (governance > users & roles > your user > PATs).
# the token's role restriction has to match SNOWFLAKE_ROLE below.
SNOWFLAKE_PASSWORD=

#leave these
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=OLIST_WH
