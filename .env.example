# copy to .env and fill in. .env is gitignored
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=
# plain password login gets blocked by MFA from scripts.
# make a programmatic access token in snowsight (settings > authentication) and paste it here instead
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=OLIST_WH
